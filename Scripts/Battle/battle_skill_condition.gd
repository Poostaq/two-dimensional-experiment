class_name BattleSkillCondition
extends RefCounted

enum Kind {
	PRIMARY_SNARED,
	PRIMARY_ATTACKED_ALLY_THIS_ROUND,
	PRIMARY_BLEEDING,
	PRIMARY_BELOW_HALF_HP,
	PRIMARY_HIT_BY_ALLY_THIS_ROUND,
	PRIMARY_CONSUMED_ADVANTAGE_THIS_ROUND,
	ALLY_ACTED_BEFORE_ACTOR_THIS_ROUND,
	PRIMARY_DIFFERENT_RACE_FROM_ACTOR,
	PRIMARY_ADVANTAGE,
	PRIMARY_SNARED_OR_ADVANTAGE,
	PRIMARY_LOST_ARMOR_THIS_ROUND,
	PRIMARY_MOVED_THIS_ROUND,
	PRIMARY_MOVED_TWO_OR_MORE_THIS_ROUND,
	PRIMARY_MOVED_OR_STUNNED_THIS_ROUND,
	ALLIES_BELOW_HALF_AT_LEAST_TWO,
	PRIMARY_POWER_POISON_FROM_ACTOR,
	PRIMARY_SPEED_POISON_FROM_ACTOR,
	PRIMARY_HAS_ANY_POISON,
	ACTOR_NOT_MOVED_THIS_ROUND,
	ACTOR_ARMOR_AT_MOST_TWO,
	ACTOR_HAS_ARMOR,
	PRIMARY_BELOW_SEVENTY_PERCENT_HP,
	PRIMARY_BELOW_SEVENTY_FIVE_PERCENT_HP,
	PRIMARY_HAS_ARMOR,
	ACTOR_BELOW_SEVENTY_PERCENT_HP,
	ACTOR_BELOW_HALF_HP,
	ANY_ENEMY_BELOW_SEVENTY_PERCENT_HP,
	ANY_ENEMY_BELOW_HALF_HP,
	ANY_ENEMY_ABOVE_HALF_HP,
	PRIMARY_ENCLOSED,
	PRIMARY_ATTACKED_ARMORED_ALLY_THIS_ROUND,
	PRIMARY_ATTACKED_ACTOR_OR_ADJACENT_ALLY_THIS_ROUND,
	ANY_SELECTED_SNARED,
}

var kind: Kind:
	get:
		return _kind

var _kind: Kind = Kind.PRIMARY_SNARED
var _is_valid: bool = false


func _init(condition_kind: int) -> void:
	if condition_kind not in [
		Kind.PRIMARY_SNARED,
		Kind.PRIMARY_ATTACKED_ALLY_THIS_ROUND,
		Kind.PRIMARY_BLEEDING,
		Kind.PRIMARY_BELOW_HALF_HP,
		Kind.PRIMARY_HIT_BY_ALLY_THIS_ROUND,
		Kind.PRIMARY_CONSUMED_ADVANTAGE_THIS_ROUND,
		Kind.ALLY_ACTED_BEFORE_ACTOR_THIS_ROUND,
		Kind.PRIMARY_DIFFERENT_RACE_FROM_ACTOR,
		Kind.PRIMARY_ADVANTAGE,
		Kind.PRIMARY_SNARED_OR_ADVANTAGE,
		Kind.PRIMARY_LOST_ARMOR_THIS_ROUND,
		Kind.PRIMARY_MOVED_THIS_ROUND,
		Kind.PRIMARY_MOVED_TWO_OR_MORE_THIS_ROUND,
		Kind.PRIMARY_MOVED_OR_STUNNED_THIS_ROUND,
		Kind.ALLIES_BELOW_HALF_AT_LEAST_TWO,
		Kind.PRIMARY_POWER_POISON_FROM_ACTOR,
		Kind.PRIMARY_SPEED_POISON_FROM_ACTOR,
		Kind.PRIMARY_HAS_ANY_POISON,
		Kind.ACTOR_NOT_MOVED_THIS_ROUND,
		Kind.ACTOR_ARMOR_AT_MOST_TWO,
		Kind.ACTOR_HAS_ARMOR,
		Kind.PRIMARY_BELOW_SEVENTY_PERCENT_HP,
		Kind.PRIMARY_BELOW_SEVENTY_FIVE_PERCENT_HP,
		Kind.PRIMARY_HAS_ARMOR,
		Kind.ACTOR_BELOW_SEVENTY_PERCENT_HP,
		Kind.ACTOR_BELOW_HALF_HP,
		Kind.ANY_ENEMY_BELOW_SEVENTY_PERCENT_HP,
		Kind.ANY_ENEMY_BELOW_HALF_HP,
		Kind.ANY_ENEMY_ABOVE_HALF_HP,
		Kind.PRIMARY_ENCLOSED,
		Kind.PRIMARY_ATTACKED_ARMORED_ALLY_THIS_ROUND,
		Kind.PRIMARY_ATTACKED_ACTOR_OR_ADJACENT_ALLY_THIS_ROUND,
		Kind.ANY_SELECTED_SNARED,
	]:
		return
	_kind = condition_kind as Kind
	_is_valid = true


static func create(condition_kind: int) -> RefCounted:
	var condition: RefCounted = load("res://Scripts/Battle/battle_skill_condition.gd").new(condition_kind)
	return condition if condition.is_valid() else null


func is_valid() -> bool:
	return _is_valid


func duplicate_condition() -> RefCounted:
	if not is_valid():
		return null
	var condition_script: Script = load("res://Scripts/Battle/battle_skill_condition.gd") as Script
	return condition_script.create(_kind)
